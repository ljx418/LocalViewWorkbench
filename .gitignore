# Reconstructible caches and local runtime/dependencies; never blanket-ignore reports.
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/.venv/
**/.lvw-runtime/
# New reports retain raw commands/results, not extracted source/test work trees.
**/reports/**/pytest-temp/
**/reports/**/pytest-tmp/
**/reports/**/pytest-recheck-tmp/
**/reports/**/pytest-recheck-temp/
**/reports/**/final-pytest-temp/
**/reports/**/recheck-pytest-temp/
**/reports/**/recheck-pytest-tmp/
**/reports/**/candidate-source/
