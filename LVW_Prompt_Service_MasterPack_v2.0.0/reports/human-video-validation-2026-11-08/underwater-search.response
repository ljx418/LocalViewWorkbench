{"batchcomplete":"","continue":{"gsroffset":5,"continue":"gsroffset||"},"query":{"pages":{"149573625":{"pageid":149573625,"ns":6,"title":"File:Autonomous Underwater Vehicle (AUV) in the Flinders Australian Marine Park.webm","index":5,"imagerepository":"local","imageinfo":[{"size":4722267,"width":640,"height":480,"duration":68.161,"url":"https://upload.wikimedia.org/wikipedia/commons/e/e7/Autonomous_Underwater_Vehicle_%28AUV%29_in_the_Flinders_Australian_Marine_Park.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Autonomous_Underwater_Vehicle_(AUV)_in_the_Flinders_Australian_Marine_Park.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=149573625","extmetadata":{"DateTime":{"value":"2024-06-21 00:53:09","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Autonomous Underwater Vehicle (AUV) in the Flinders Australian Marine Park","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Media from YouTube|Seabed|Underwater vehicles|License review needed (video)|Uploaded with video2commons|Underwater videos|Flinders Australian Marine Park|Videos uploaded by Prototyperspective","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This video was collected as part of a trial of the use of AUV mounted video for describing epi-benthic (off the bottom) fish and their associated habitat features as part of non-intrusive monitoring methods for AMPs. The video is from the AUV GRTS-based transects on the comprehensively mapped outer shelf region of the Flinders AMP in June 2013. The video shows reef and sediments in 90 m depth, highlighting the low profile nature of many of these reefs, and the association of particular fish species with reef features. A striped trumpeter, (a key indicator species in this AMP is seen swimming over more complex reef towards the end of the video. Video credit: Institute of Marine and Antarctic Studies (IMAS). See original metadata record <a rel=\"nofollow\" class=\"external free\" href=\"https://www.nespmarine.edu.au/cmr-video\">https://www.nespmarine.edu.au/cmr-video</a>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2018-04-17","source":"commons-desc-page"},"Credit":{"value":"<bdi lang=\"en\" dir=\"ltr\"><a href=\"//commons.wikimedia.org/wiki/Commons:YouTube_files\" title=\"Commons:YouTube files\">YouTube</a>: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/watch?v=v_HXo0ADqeI\"><bdi lang=\"\">Autonomous Underwater Vehicle (AUV) in the Flinders Australian Marine Park</bdi></a> \u2013 View/save archived versions on <a rel=\"nofollow\" class=\"external text\" href=\"https://web.archive.org/web/*/https://www.youtube.com/watch?v=v_HXo0ADqeI\">archive.org</a></bdi>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/@australianmarineparksscien9540\">Australian Marine Parks Science Atlas</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Australian Marine Parks Science Atlas","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-3.0","source":"commons-templates","hidden":""}}}]},"106521423":{"pageid":106521423,"ns":6,"title":"File:Fish swimming through Bonneville Lock and Dam Fish Ladder, June 2021.webm","index":4,"imagerepository":"local","imageinfo":[{"size":25923070,"width":1920,"height":1080,"duration":60.54,"url":"https://upload.wikimedia.org/wikipedia/commons/c/c4/Fish_swimming_through_Bonneville_Lock_and_Dam_Fish_Ladder%2C_June_2021.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Fish_swimming_through_Bonneville_Lock_and_Dam_Fish_Ladder,_June_2021.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=106521423","extmetadata":{"DateTime":{"value":"2021-06-12 21:44:17","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Fish swimming through Bonneville Lock and Dam Fish Ladder, June 2021","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Self-published work|Files with coordinates missing SDC location of creation|Bonneville Dam fish ladders","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"45.648857","source":"commons-desc-page"},"GPSLongitude":{"value":"-121.934938","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"Fish swimming through the Fish Ladder of the Bonneville Lock and Dam as seen through underwater viewing windows in the Fish Viewing Building. Video taken on 2021-06-11T21:44:41Z.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2021-06-11","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Baltakatei\" title=\"User:Baltakatei\">Steven Baltakatei Sandoval</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"156873447":{"pageid":156873447,"ns":6,"title":"File:Three dimensional fish school underwater scene (3D) (M\u00e9diHAL 4372006).webm","index":1,"imagerepository":"local","imageinfo":[{"size":2419039,"width":768,"height":576,"duration":20.255,"url":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Three_dimensional_fish_school_underwater_scene_%283D%29_%28M%C3%A9diHAL_4372006%29.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Three_dimensional_fish_school_underwater_scene_(3D)_(M%C3%A9diHAL_4372006).webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=156873447","extmetadata":{"DateTime":{"value":"2024-12-19 03:23:56","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Three dimensional fish school underwater scene (3D) (M\u00e9diHAL 4372006)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Schools of fish|PD France|Uploaded with video2commons|Video display resolution 720 x 576|Videos taken on 2006-03-28|M\u00e9diHAL files uploaded by OptimusPrimeBot","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Fish schools are aggregative structures encountered in all types of aquatic environments but have as yet been little studied in freshwaters except at small spatial scales. This study represents the three dimensional description of juvenile fish schools (Perca fluviatilis and Rutilus rutilus) in a lake environment using high resolution multibeam sonar system operating at a frequency of 455 kHz, composed of 60 beams of 1.5\u00b0 allowing a 90\u00b0 observation plane. The in situ diurnal schooling behaviour of young-of-the-year fish of both species is confirmed. The morphological, energetic and spatial variables of these schools are described and related to one another. The structures described are of the same order of magnitude as those described in the marine environment. The school shape is elliptical, they are shallow and they display a temporal and spatial stability over the course of a day but a highly variable morphology. The number of vacuoles, a descriptor of the internal morphology of the schools, was found to be significantly (p &lt; 0.01) correlated with the volume of the school, and showed two distinct relationships, with proportions similar to the percentage occurrence of both species sampled by a pelagic trawl. The relation may be efficient for fish species discrimination by 3-D acoustics methods in this lake with two main aggregative fish species.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a028 March 2006","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://hal.science/hal-04372006v1\">Three dimensional fish school underwater scene (3D)</a>","source":"commons-desc-page"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q57897453\" class=\"extiw\" title=\"d:Q57897453\"><span title=\"researcher, ORCID id # 0000-0001-8949-9095\">Patrice Brehmer</span></a></bdi> / <bdi><a href=\"https://www.wikidata.org/wiki/Q30262159\" class=\"extiw\" title=\"d:Q30262159\"><span title=\"facility in Plouzan\u00e9, France\">Laboratory of Environnemental Marine Sciences</span></a>\n</bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/en:Research_Institute_for_Development\" class=\"extiw\" title=\"w:en:Research Institute for Development\"><span title=\"French science and technology research institute\">French National Research Institute for Sustainable Development</span></a>\n</bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/en:IFREMER\" class=\"extiw\" title=\"w:en:IFREMER\"><span title=\"French research institute for the exploitation of maritime environment\">IFREMER</span></a>\n</bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/en:French_National_Centre_for_Scientific_Research\" class=\"extiw\" title=\"w:en:French National Centre for Scientific Research\"><span title=\"French research organisation\">National Center for Scientific Research</span></a>\n</bdi> / <bdi><a href=\"https://www.wikidata.org/wiki/Q3152437\" class=\"extiw\" title=\"d:Q3152437\"><span title=\"research institute in France\">INSU</span></a>\n</bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/en:University_of_Western_Brittany\" class=\"extiw\" title=\"w:en:University of Western Brittany\"><span title=\"education organization in Brest, France\">Universit\u00e9 de Bretagne Occidentale</span></a>\n</bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"81936679":{"pageid":81936679,"ns":6,"title":"File:Underwater Videos 5.webm","index":3,"imagerepository":"local","imageinfo":[{"size":25499386,"width":1280,"height":960,"duration":18.184,"url":"https://upload.wikimedia.org/wikipedia/commons/0/09/Underwater_Videos_5.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Underwater_Videos_5.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=81936679","extmetadata":{"DateTime":{"value":"2019-09-07 07:23:18","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Underwater Videos 5","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Videos of underwater diving|Flickr images missing SDC creator|Flickr images missing SDC source of file|Videos of 2013|Uploaded with video2commons|Videos taken with GoPro|Flickr videos reviewed by trusted users","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>Mahogany Bay, Isla Roatan, Honduras  \n</p>\nAngel Fish","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2013-09-22","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://flickr.com/photos/scubabix/9880296363/\">Underwater Videos - Flickr</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/scubabix/\">Rob Bixby</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Rob Bixby","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},"81936474":{"pageid":81936474,"ns":6,"title":"File:Underwater Videos 6.webm","index":2,"imagerepository":"local","imageinfo":[{"size":19243689,"width":1