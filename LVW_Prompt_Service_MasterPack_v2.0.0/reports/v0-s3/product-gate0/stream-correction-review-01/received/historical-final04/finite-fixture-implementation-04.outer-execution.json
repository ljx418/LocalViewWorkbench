    },
    "nonfinite_number": {
      "cause": "tools/fixtures/v0_s3_supervisor_fixture.py scenario_nonfinite_number uses Writer.write_raw(), which writes the JSON line WITHOUT the trailing b\"\\n\" that Writer.write() appends; the parent supervisor frames protocol lines on b\"\\n\" (tools/v0_s3_supervisor.py _consume_stdout), so the line is never decoded, json.loads(parse_constant=_reject_constant) never runs, and MESSAGE_NONFINITE_NUMBER is never produced",
      "child_lifetime_seconds": 1.07,
      "classification": "deterministic candidate-side mismatch between the fixture scenario and the frozen line framing; not timing flakiness, not a budget effect",
