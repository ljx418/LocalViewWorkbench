{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lvw:v1-multishot:design-candidate:1.1",
  "title": "V1 multi-shot design1.1; not activated product contract",
  "x-status": "DESIGN_REVIEW",
  "x-activation": "independent recheck and Codex Gate0 overlay/migration required",
  "$defs": {
    "CoreScene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "media_ref_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "start_pts": {
          "type": "integer"
        },
        "end_pts": {
          "type": "integer"
        },
        "origin_pts": {
          "type": "integer"
        },
        "time_base_num": {
          "type": "integer",
          "minimum": 1
        },
        "time_base_den": {
          "type": "integer",
          "minimum": 1
        },
        "verified": {
          "type": "boolean"
        },
        "editor": {
          "type": "string",
          "enum": [
            "algorithm",
            "human"
          ]
        }
      },
      "required": [
        "id",
        "media_ref_id",
        "revision",
        "start_pts",
        "end_pts",
        "origin_pts",
        "time_base_num",
        "time_base_den",
        "verified",
        "editor"
      ],
      "additionalProperties": false
    },
    "ShotFrameRef": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "target_seconds": {
          "type": "number",
          "minimum": 0
        },
        "source_pts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "type": "integer"
        },
        "time_base_num": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "type": "integer"
        },
        "time_base_den": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "time_basis": {
          "const": "decoded_pts"
        }
      },
      "required": [
        "index",
        "target_seconds",
        "source_pts",
        "time_base_num",
        "time_base_den",
        "sha256",
        "time_basis"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "shape is a valid canonical FrameRef; serialized unchanged into ModelRun.frames",
        "indices consecutive0..n-1, n1..4; no duplicatePTS or frame SHA",
        "source time lies within bound [start,end); target_seconds is absolute normalized media seconds"
      ]
    },
    "SceneRevisionInfo": {
      "type": "object",
      "properties": {
        "scene_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "$ref": "#/$defs/CoreScene"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scene_revision_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "etag": {
          "type": "string",
          "minLength": 1
        },
        "time_basis": {
          "enum": [
            "decoded_pts",
            "estimated",
            "unverified"
          ]
        }
      },
      "required": [
        "scene_revision_id",
        "scene_id",
        "scene",
        "source_sha256",
        "scene_revision_hash",
        "etag",
        "time_basis"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "scene.id==scene_id, scene.revision==immutable revision number",
        "scene.verified iff time_basis==decoded_pts",
        "only decoded_pts/verified revisions may start M1 analysis; others reject422 SCENE_TIME_UNVERIFIED",
        "Scene editor algorithm corresponds detector origin, human to manual edit; no new vocabulary in canonical Scene"
      ]
    },
    "AnalysisBinding": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_ref_id": {
          "type": "string",
          "minLength": 1
        },
        "media_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "lease_token": {
          "type": "string",
          "minLength": 1
        },
        "cancel_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "shot_id",
        "scene_revision_id",
        "scene_revision_hash",
        "media_ref_id",
        "media_sha256",
        "config_hash",
        "attempt_id",
        "lease_token",
        "cancel_epoch"
      ],
      "additionalProperties": false,
      "x-exposure": "Internal only; token never serialized to client/model prompt/log"
    },
    "PublicAnalysisBinding": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_ref_id": {
          "type": "string",
          "minLength": 1
        },
        "media_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "cancel_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "shot_id",
        "scene_revision_id",
        "scene_revision_hash",
        "media_ref_id",
        "media_sha256",
        "config_hash",
        "attempt_id",
        "cancel_epoch"
      ],
      "additionalProperties": false
    },
    "BilingualPhrase": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "maxLength": 80
        },
        "en": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "zh": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "en": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "BilingualSummary": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "maxLength": 400
        },
        "en": {
          "type": "string",
          "maxLength": 600
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "zh": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "en": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "Character": {
      "type": "object",
      "properties": {
        "local_actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "visible_appearance": {
          "$ref": "#/$defs/BilingualPhrase"
        },
        "domain": {
          "enum": [
            "observation",
            "inference"
          ]
        },
        "evidence_frame_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "local_actor_id",
        "visible_appearance",
        "domain",
        "evidence_frame_indices"
      ],
      "additionalProperties": false
    },
    "SceneEvidence": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/BilingualPhrase"
        },
        "domain": {
          "enum": [
            "observation",
            "inference"
          ]
        },
        "evidence_frame_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "domain",
        "evidence_frame_indices"
      ],
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "properties": {
        "actor_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "description": {
          "$ref": "#/$defs/BilingualPhrase"
        },
        "domain": {
          "enum": [
            "observation",
            "inference"
          ]
        },
        "evidence_frame_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "actor_ref",
        "description",
        "domain",
        "evidence_frame_indices"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "non-null actor_ref resolves in same shot",
        "change inference needs >=2 distinct source times; one frame supports pose only"
      ]
    },
    "MachineShotResponse": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Character"
          },
          "maxItems": 4
        },
        "scene": {
          "$ref": "#/$defs/SceneEvidence"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 4
        },
        "summary": {
          "$ref": "#/$defs/BilingualSummary"
        },
        "negative": {
          "type": "string",
          "maxLength": 400
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 8
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BilingualPhrase"
          },
          "maxItems": 8
        }
      },
      "required": [
        "characters",
        "scene",
        "actions",
        "summary",
        "negative",
        "tags",
        "unknowns"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "model cannot supply FrameRefs/hash/binding or human source domains",
        "character detail and action lists bounded; crowded/uncertain cases disclosed in unknowns; do not claim exhaustive actor tracking"
      ]
    },
    "ShotEvidence": {
      "type": "object",
      "properties": {
        "frame_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShotFrameRef"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Character"
          },
          "maxItems": 4
        },
        "scene": {
          "$ref": "#/$defs/SceneEvidence"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 4
        },
        "summary": {
          "$ref": "#/$defs/BilingualSummary"
        },
        "negative": {
          "type": "string",
          "maxLength": 400
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 8
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BilingualPhrase"
          },
          "maxItems": 8
        }
      },
      "required": [
        "frame_refs",
        "characters",
        "scene",
        "actions",
        "summary",
        "negative",
        "tags",
        "unknowns"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "FrameRefs are server-owned additions; raw MachineShotResponse retained byte-for-byte",
        "all refs resolve within same shot and all local actor ids unique",
        "domain routes characters/scene/actions to canonical observation or inference",
        "unknowns route to canonical unknowns; user_evidence/creative_intent are human-owned, never generated from raw",
        "bilingual summary supplies canonical text_zh/text_en; absent translation stays absent, no CPU fake translation"
      ]
    },
    "BatchAnalyzeRequest": {
      "type": "object",
      "properties": {
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "scene_revision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "documentary",
            "realistic",
            "scifi",
            "science",
            "cinematic",
            "stylized"
          ]
        },
        "config_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "content_profile": {
          "enum": [
            "standard",
            "faithful",
            "adult-art",
            "medical"
          ],
          "default": "standard"
        },
        "custom_guidance": {
          "type": "string",
          "maxLength": 800,
          "default": ""
        },
        "retry_of_parent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "shot_ids",
        "scene_revision_ids",
        "mode",
        "config_profile"
      ],
      "additionalProperties": false,
      "x-route": "POST /api/v1/jobs/shot-batches ONLY; never replaces canonical /jobs/batch items body",
      "x-semantic-invariants": [
        "ordered lists same length, one-to-one current binding, all same source media",
        "retry parent if supplied belongs to same source; only prior failed/interrupted child bindings selectable; prior successful rows remain immutable"
      ]
    },
    "ParentJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "planned_child_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "selected_scene_revision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "terminal_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "deadline_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "execution_budget_seconds": {
          "type": "integer",
          "minimum": 540,
          "maximum": 5490
        },
        "status": {
          "enum": [
            "queued",
            "preparing",
            "running",
            "partial",
            "succeeded",
            "failed",
            "cancelling",
            "cancelled",
            "interrupted",
            "submission_unknown"
          ]
        },
        "not_executed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "retry_of_parent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "plan_hash",
        "planned_child_ids",
        "selected_scene_revision_ids",
        "total",
        "terminal_count",
        "deadline_at",
        "execution_budget_seconds",
        "status",
        "not_executed_count",
        "retry_of_parent_id"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "id=canonical Job.id; progress_done=terminal_count; progress_total=total",
        "execution_budget_seconds=450*total+90; deadline_at=created_at+budget; no extension on restart",
        "deadline/plan immutable; terminal_count derived from persisted children, not a mutable separate counter",
        "not_executed_count counts no attempted model send, not no CPU preparation"
      ]
    },
    "ChildSummary": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "queued",
            "preparing",
            "running",
            "partial",
            "succeeded",
            "failed",
            "cancelling",
            "cancelled",
            "interrupted",
            "submission_unknown"
          ]
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_started": {
          "type": "boolean"
        },
        "retry_of_child_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "ordinal",
        "job_id",
        "shot_id",
        "scene_revision_id",
        "scene_revision_hash",
        "status",
        "result_ref",
        "error_code",
        "model_started",
        "retry_of_child_id"
      ],
      "additionalProperties": false
    },
    "BatchChildrenResponse": {
      "type": "object",
      "properties": {
        "parent": {
          "$ref": "#/$defs/ParentJob"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChildSummary"
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "parent",
        "children"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "len(children)==parent.total; ordinal exactly0..total-1 and IDs match immutable plan",
        "deadline not-started => failed+BATCH_DEADLINE_EXCEEDED+model_startedFalse; parent cancel => cancelled+JOB_CANCELLED",
        "all planned rows retained, including failed/interrupted/cancelled; no invented NOT_RUN Job enum"
      ]
    },
    "ShotAnalysisEvidence": {
      "type": "object",
      "properties": {
        "model_run_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/PublicAnalysisBinding"
        },
        "state": {
          "enum": [
            "current",
            "stale",
            "partial"
          ]
        },
        "raw_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/ShotEvidence"
        }
      },
      "required": [
        "model_run_id",
        "binding",
        "state",
        "raw_schema_version",
        "evidence"
      ],
      "additionalProperties": false,
      "x-route": "GET /api/v1/shots/{id}/analyses/{run_id}/evidence"
    },
    "ShotSceneBinding": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scene_revision_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "etag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "shot_id",
        "scene_revision_id",
        "scene_revision_hash",
        "etag"
      ],
      "additionalProperties": false,
      "x-semantic-invariants": [
        "both scene fields null for unbound image/manual shot; otherwise FK and content hash resolve to same media",
        "writes require canonical Shot etag and update current pointer only, never old prompt revision"
      ]
    }
  }
}
